# App
APP_NAME=ObrPortal
ENVIRONMENT=local
API_PORT=8000
FRONTEND_PORT=5173

# Security — change in every real environment
SECRET_KEY=change-me-local-only
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
POSTGRES_DB=obrportal
POSTGRES_USER=obrportal
POSTGRES_PASSWORD=obrportal_password
DATABASE_URL=postgresql+asyncpg://obrportal:obrportal_password@postgres:5432/obrportal

# Redis
REDIS_URL=redis://redis:6379/0

# S3 / MinIO
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PRIVATE=obrportal-private
S3_BUCKET_PUBLIC=obrportal-public

# Frontend
VITE_API_URL=http://localhost:8000

# Local seed organization
SEED_ORG_INN=0278000001
SEED_ORG_KPP=027801001
SEED_ORG_OGRN=1020200000001
SEED_ORG_NAME=GBOU RCDO
SEED_ORG_LEGAL_ADDRESS=Republic of Bashkortostan, Ufa
SEED_ORG_ACTUAL_ADDRESS=Republic of Bashkortostan, Ufa

# Local demo learning data
SEED_DEMO_COURSE_SLUG=demo-course
SEED_DEMO_COURSE_TITLE=Demo Course
SEED_DEMO_COURSE_DESCRIPTION=Demo course for local UX testing.
SEED_DEMO_COURSE_HOURS=72
SEED_DEMO_COURSE_FORMAT=online
SEED_DEMO_COURSE_DOCUMENT_TYPE=certificate
SEED_DEMO_GROUP_CODE=DEMO-GROUP
SEED_DEMO_GROUP_NAME=Demo Group
SEED_DEMO_GROUP_DESCRIPTION=Demo learning group for local UX testing.
